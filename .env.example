# ---- db --------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://prorag:prorag@localhost:5432/prorag
POSTGRES_USER=prorag
POSTGRES_PASSWORD=prorag
POSTGRES_DB=prorag

# ---- models ------------------------------------------------------------------
# LiteLLM model config (OpenAI-flavored defaults; swap provider by changing the
# string — e.g. openrouter/..., local/<hf-model>). Any OpenAI-compatible
# internal gateway works too; point these at it for an air-gapped install.
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
ANSWER_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
# Provider API key(s) — whatever LiteLLM needs for the models above. `prorag
# doctor`'s llm/embed checks WARN (not FAIL) and skip their pings if this is
# unset, since local-only setups (EMBED_MODEL=local/...) don't need one.
OPENAI_API_KEY=

# Rerank — "api" = OpenRouter's hosted cross-encoder endpoint (default; real
# cross-encoder scores, ~$0.001/call against OPENROUTER_API_KEY credit).
# "local" = CPU sentence-transformers cross-encoder (measurably slow — #11).
RERANK_ENABLED=true
RERANK_BACKEND=api
RERANK_API_MODEL=cohere/rerank-v3.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- ingestion -----------------------------------------------------------
BLOB_DIR=./blobs
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# ---- retrieval -----------------------------------------------------------
SEARCH_TOP_K=5

# ---- auth + sessions + oidc (Phase 5/6, #19) ------------------------------
AUTH_ENABLED=false
# SESSION_COOKIE_SECURE=false  # uncomment for local http:// dev — cookie needs https otherwise
SESSION_TTL_DAYS=7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_PATH=/auth/oidc/callback

# ---- ops -------------------------------------------------------------------
DAILY_COST_CAP_USD=5.0
FALLBACK_PRICE_PER_1K_USD=0.002
# Versioned bundle tag (#20) — compose reads this for the api image's tag;
# unset/dev uses the locally built image.
PRORAG_VERSION=dev
