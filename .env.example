# Postgres
DATABASE_URL=postgresql+asyncpg://prorag:prorag@localhost:5432/prorag
POSTGRES_USER=prorag
POSTGRES_PASSWORD=prorag
POSTGRES_DB=prorag

# LiteLLM model config (OpenAI-flavored defaults; swap provider by changing the string)
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
ANSWER_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini

# Provider API key(s) — whatever LiteLLM needs for the models above
OPENAI_API_KEY=

# Storage
BLOB_DIR=./blobs

# Chunking
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# Retrieval
SEARCH_TOP_K=5

# Operations (Phase 5)
AUTH_ENABLED=false
DAILY_COST_CAP_USD=5.0
FALLBACK_PRICE_PER_1K_USD=0.002

# Sessions + OIDC (Phase 6, #19)
# SESSION_COOKIE_SECURE=false  # uncomment for local http:// dev — cookie needs https otherwise
SESSION_TTL_DAYS=7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_PATH=/auth/oidc/callback
